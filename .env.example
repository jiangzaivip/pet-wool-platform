# Runtime storage: use postgres after completing the JSON migration.
STORE_BACKEND=json
DATABASE_URL=postgres://pet:pet_password@localhost:5432/pet_wool
SERVER_ADDR=0.0.0.0:8080
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# Node API production overrides
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_sha256_password_hash
# Optional multi-admin role config. Roles: owner, admin, viewer.
ADMIN_ACCOUNTS_JSON=[{"email":"owner@example.com","password_hash":"replace_with_sha256_password_hash","role":"owner"}]
ADMIN_SESSION_SECRET=replace_with_long_random_secret
USER_TOKEN_SECRET=replace_with_long_random_secret

# Google sign-in. Set GOOGLE_DEMO_LOGIN=false after a real OAuth client ID is configured.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_IDS=replace_with_google_oauth_client_id,optional_second_client_id
GOOGLE_DEMO_LOGIN=false

# PayPal account settings are managed in the admin dashboard.
# Keep only technical/test switches here; do not add PayPal credentials.
PAYPAL_TIMEOUT_MS=15000
PAYPAL_MOCK=false

# Free translation service used by the admin translation buttons.
# Leave these defaults unless you need to point to another compatible endpoint.
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_TIMEOUT_MS=12000

# Optional SMTP notifications. In production configure all required fields.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=WoolBuddy <orders@example.com>
NOTIFY_ADMIN_EMAIL=owner@example.com
SMTP_TIMEOUT_MS=10000

# Structured API logs. The default file is ./logs/pet-wool-structured.log.
LOG_LEVEL=info
LOG_TO_FILE=true
# LOG_DIR=/absolute/path/to/logs
# LOG_FILE=/absolute/path/to/logs/pet-wool-structured.log

# Used by production:check and PayPal return/webhook deployment documentation.
PUBLIC_BASE_URL=https://example.com
