DATABASE_URL=postgres://pet:pet_password@localhost:5432/pet_wool
SERVER_ADDR=0.0.0.0:8080
JWT_SECRET=change_me_to_a_long_random_secret
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# Node API production overrides
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_sha256_password_hash
# Optional multi-admin role config. Roles: owner, admin, viewer.
ADMIN_ACCOUNTS_JSON=[{"email":"owner@example.com","password_hash":"replace_with_sha256_password_hash","role":"owner"}]
ADMIN_SESSION_SECRET=replace_with_long_random_secret
USER_TOKEN_SECRET=replace_with_long_random_secret

# Google sign-in. Set GOOGLE_DEMO_LOGIN=false after a real OAuth client ID is configured.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_IDS=replace_with_google_oauth_client_id,optional_second_client_id
GOOGLE_DEMO_LOGIN=false

# PayPal Orders API. PAYPAL_ENV can be sandbox or live.
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_SECRET=replace_with_paypal_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
PAYPAL_ENV=sandbox
PAYPAL_MOCK=false
