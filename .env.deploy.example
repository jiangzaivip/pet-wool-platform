# Copy this file to .env only when you need to override defaults.
# The package can start without .env.

HOST=0.0.0.0
PORT=8888
SERVE_FRONTEND=true
NODE_ENV=production
PUBLIC_BASE_URL=https://your-domain.example

# Set STORE_BACKEND=postgres and a local DATABASE_URL after running the
# migration script. The default remains JSON for a fresh package install.
STORE_BACKEND=json
# DATABASE_URL=postgresql://pet_wool_app:change_me@127.0.0.1:5432/pet_wool

# Admin login. Default package login is admin@example.com / admin123456.
# Replace this before public production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace_with_sha256_password_hash
ADMIN_SESSION_SECRET=replace_with_long_random_secret
USER_TOKEN_SECRET=replace_with_long_random_secret

# Optional multi-admin config. Keep the JSON quoted when using start.sh.
# ADMIN_ACCOUNTS_JSON='[{"email":"owner@example.com","password_hash":"replace_with_sha256_password_hash","role":"owner"}]'

# Google sign-in.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_IDS=replace_with_google_oauth_client_id
GOOGLE_DEMO_LOGIN=false

# PayPal account settings are managed in the admin dashboard.
# Keep only technical/test switches here; do not add PayPal credentials.
PAYPAL_TIMEOUT_MS=15000
PAYPAL_MOCK=false

# Free translation service used by the admin translation buttons.
# Leave these defaults unless you need to point to another compatible endpoint.
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_TIMEOUT_MS=12000

# Optional QQ Mail SMTP order notifications.
# Use the authorization code generated in QQ Mail, not the QQ login password.
# For port 587 use SMTP_SECURE=false.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@qq.com
SMTP_PASS=replace_with_qq_mail_authorization_code
SMTP_FROM=WoolBuddy <your-address@qq.com>
NOTIFY_ADMIN_EMAIL=your-address@qq.com
SMTP_TIMEOUT_MS=10000

# Structured API logs. Keep this directory outside the release package if
# releases are replaced in place.
LOG_LEVEL=info
LOG_TO_FILE=true
# LOG_DIR=/var/log/pet-wool-platform
# LOG_FILE=/var/log/pet-wool-platform/pet-wool-structured.log
