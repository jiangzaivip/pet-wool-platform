[Unit]
Description=Pet Wool Platform data backup
After=pet-wool-api.service

[Service]
Type=oneshot
WorkingDirectory=/root/pet-wool-platform
Environment=BACKUP_KEEP=14
ExecStart=/usr/bin/node /root/pet-wool-platform/scripts/backup-data.mjs
# The backup archive contains customer PII, PayPal secrets and upload files.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome must stay off: the whole project lives under /root, and hiding it
# makes the service die with 200/CHDIR before it can read store.json.
ReadWritePaths=/root/pet-wool-platform/api-node
ReadOnlyPaths=/root/pet-wool-platform/scripts
